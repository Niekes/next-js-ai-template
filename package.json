{
  "name": "next-js-ai-template",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "vp check",
    "test": "vp test run",
    "test:watch": "vp test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:setup": "drizzle-kit generate && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "gen": "plop",
    "arch:diagram": "tsx scripts/arch-diagram.ts",
    "size:scan": "tsx scripts/find-large-functions.ts",
    "security": "tsx scripts/security-gate.ts",
    "prepare": "husky",
    "fallow": "fallow audit --coverage coverage/coverage-final.json && fallow health --coverage coverage/coverage-final.json && fallow health --coverage coverage/coverage-final.json --min-score 100",
    "fallow:check": "fallow dead-code && fallow dupes",
    "fallow:full": "fallow dead-code && fallow health --coverage coverage/coverage-final.json && fallow dupes",
    "verify": "pnpm typecheck && pnpm lint && pnpm test --coverage && pnpm fallow && pnpm fallow:check && pnpm security && pnpm build"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.25",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@tanstack/react-query": "^5.105.0",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "postgres": "^4.1.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/eslint-plugin-query": "^5.105.0",
    "@testing-library/react": "catalog:",
    "@types/node": "^26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "archunit": "^2.5.4",
    "badge-maker": "^6.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "fallow": "^3.43.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "plop": "^4.0.5",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.14.0"
}
