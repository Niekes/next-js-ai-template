{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".agents/skills"]
  },
  "mcp": {
    "fallow": {
      "type": "local",
      "command": ["npx", "fallow-mcp"],
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "better-auth": {
      "type": "remote",
      "url": "https://mcp.better-auth.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "edit": {
      "*": "allow",
      ".fallowrc.json": "ask",
      ".husky/**": "ask",
      ".github/workflows/**": "ask",
      ".github/actions/**": "ask",
      "drizzle.config.ts": "ask",
      "vitest.config.ts": "ask",
      ".claude/settings.json": "ask",
      "opencode.json": "ask",
      "src/lib/architecture/**": "ask",
      "security-accepted.json": "ask",
      "scripts/security-gate.ts": "ask",
      "src/lib/db/migrations/**": "deny",
      "pnpm-lock.yaml": "deny",
      ".agents/**": "deny",
      "src/components/ui/**": "deny",
      "skills-lock.json": "deny",
      ".github/badges/**": "deny",
      "next-env.d.ts": "deny",
      "*.tsbuildinfo": "deny",
      ".env": "deny",
      "node_modules/**": "deny",
      ".next/**": "deny",
      "coverage/**": "deny",
      "reports/**": "deny",
      ".fallow/**": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "deny"
    }
  }
}
