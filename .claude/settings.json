{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "deny": [
      "Edit(/src/lib/db/migrations/**)",
      "Edit(/pnpm-lock.yaml)",
      "Edit(/.agents/**)",
      "Edit(/src/components/ui/**)",
      "Edit(/skills-lock.json)",
      "Edit(/.github/badges/**)",
      "Edit(/next-env.d.ts)",
      "Edit(/*.tsbuildinfo)",
      "Edit(/.env)",
      "Edit(/node_modules/**)",
      "Edit(/.next/**)",
      "Edit(/coverage/**)",
      "Edit(/reports/**)",
      "Edit(/.fallow/**)",
      "Read(/.env)"
    ],
    "ask": [
      "Edit(/.fallowrc.json)",
      "Edit(/.husky/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.github/actions/**)",
      "Edit(/.github/CODEOWNERS)",
      "Edit(/drizzle.config.ts)",
      "Edit(/vitest.config.ts)",
      "Edit(/.claude/settings.json)",
      "Edit(/.mcp.json)",
      "Edit(/src/lib/architecture/**)",
      "Edit(/security-accepted.json)",
      "Edit(/scripts/security-gate.ts)",
      "Edit(/scripts/agent-guard.ts)",
      "Edit(/pnpm-workspace.yaml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"$CLAUDE_PROJECT_DIR/scripts/agent-guard.ts\""
          }
        ]
      }
    ]
  }
}
