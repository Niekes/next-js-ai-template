# Database (docker compose up -d)
POSTGRES_URL=postgres://postgres:postgres@localhost:54322/postgres

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Production, only with more than one proxy (a CDN in front of nginx): the outer proxies'
# IPs or CIDR ranges, comma-separated, so sign-in rate limits see the real client IP.
# See README "Deploy".
# TRUSTED_PROXIES=203.0.113.0/24
